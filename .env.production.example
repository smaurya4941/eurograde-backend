# Production environment for Plesk. Copy to `.env` on the server (never commit the real file),
# then run `php artisan key:generate`. Values below are for the staging subdomains; change the two
# URLs, SESSION_DOMAIN and SANCTUM_STATEFUL_DOMAINS when moving to the main domains.

APP_NAME=EuroRank
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://eurogradeapi.ureligible.com

# The React website (CORS allow-list; comma-separate several origins).
FRONTEND_URL=https://eurograde.ureligible.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Plesk → Databases (host is usually localhost).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Cookies are shared with the website on the same parent domain (needed for CSRF on forms).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.ureligible.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=eurograde.ureligible.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# This host disables symlink()/exec(), so `storage:link` fails: keep public media directly in
# public/storage instead (URLs stay /storage/...). Re-run the ContentSeeder after enabling it.
FILESYSTEM_PUBLIC_IN_WEBROOT=true
# Queued e-mails are processed by a Plesk scheduled task (see DEPLOYMENT.md).
QUEUE_CONNECTION=database
CACHE_STORE=database

# Plesk → Mail, or your SMTP provider.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@eurorank.com
MAIL_FROM_NAME="${APP_NAME}"

# Where contact-form and newsletter notifications are sent.
CONTACT_NOTIFY_EMAIL=contact@eurorank.com
# Blog comments wait for approval (post_comments.status = 'approved').
COMMENTS_REQUIRE_APPROVAL=true
